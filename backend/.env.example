# Application
ENVIRONMENT=development
DEBUG=True

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql://isms_user:isms_password@postgres:5432/isms_db

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
# WARNING: 운영 환경에서는 반드시 기본 자격 증명을 변경하세요
# docker-compose.yml의 MINIO_ROOT_USER/MINIO_ROOT_PASSWORD와 일치해야 합니다
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme-in-production
MINIO_BUCKET_NAME=isms-evidences
MINIO_SECURE=False

# SMTP (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@isms-management.com

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_DIGIT=True
PASSWORD_REQUIRE_SPECIAL=True
PASSWORD_EXPIRY_DAYS=90

# Account Security
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30
SESSION_TIMEOUT_MINUTES=30

# File Upload
MAX_UPLOAD_SIZE_MB=100

# Local LLM (Ollama) - 보완조치내역서 초안 생성
# 모든 추론은 사내 Docker 네트워크 내의 ollama 컨테이너에서만 이루어지며,
# 외부로 결함 데이터가 전송되지 않는다. LLM_ENABLED=False 로 즉시 비활성화 가능.
LLM_ENABLED=True
LLM_BASE_URL=http://ollama:11434
# GPU가 없는 노트북 환경은 qwen3.5:4b 권장 (4.7B, Q4_K_M, ~3.4GB). 2b 대비 MODE A/B
# 구분, 역할 분리, 중복 금지 규칙 준수가 현저히 개선되어 실사용 가능. CPU 기준 ~7~8분/건.
# 속도를 우선하면 2b 로 다운그레이드, GPU 서버에서는 상위 VL 모델로 업그레이드 가능.
LLM_MODEL=qwen3.5:4b
LLM_TIMEOUT_SECONDS=600
# Qwen2.5-VL 패치 크기(28px)의 배수로 내림 정렬된다. 672px가 속도/품질 균형점.
LLM_IMAGE_MAX_DIM=672
LLM_MAX_IMAGES_PER_REQUEST=4
LLM_MAX_PENDING_PER_USER=5
