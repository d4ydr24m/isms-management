# Application
ENVIRONMENT=development
DEBUG=True

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql://isms_user:isms_password@postgres:5432/isms_db

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
# WARNING: 운영 환경에서는 반드시 기본 자격 증명을 변경하세요
# docker-compose.yml의 MINIO_ROOT_USER/MINIO_ROOT_PASSWORD와 일치해야 합니다
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme-in-production
MINIO_BUCKET_NAME=isms-evidences
MINIO_SECURE=False

# SMTP (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@isms-management.com

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_DIGIT=True
PASSWORD_REQUIRE_SPECIAL=True
PASSWORD_EXPIRY_DAYS=90

# Account Security
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30
SESSION_TIMEOUT_MINUTES=30

# File Upload
MAX_UPLOAD_SIZE_MB=100
